# Copy to .env and fill in your values
PORT=8080
MONGO_URI=mongodb://localhost:27017
DB_NAME=flowzen
JWT_SECRET=replace-with-a-long-random-string
# Where the frontend is served (used for CORS and links in emails)
FRONTEND_URL=http://localhost:5500

# SMTP (leave SMTP_HOST empty in development: emails are printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Flowzen <no-reply@yourdomain.com>

UPLOAD_DIR=uploads

# First system administrator, created automatically on first start
SYSADMIN_EMAIL=admin@flowzen.app
SYSADMIN_PASSWORD=ChangeMe123!
